---
import type { Role } from '@/data/cv';
import CaseStudyLink from '@/components/case-study/CaseStudyLink.astro';
import DateRange from '@/components/DateRange.astro';
import ProjectEntry from '@/components/cv/ProjectEntry.astro';

interface Props {
  role: Role;
}

const { role } = Astro.props;
---

<article class="entry">
  <h3>{role.title} · {role.company}</h3>
  <p class="meta"><DateRange start={role.start} end={role.end} /> · {role.location}</p>
  {role.projects.map((project) => <ProjectEntry project={project} level={4} />)}
  {
    role.bullets.length > 0 && (
      <ul>
        {role.bullets.map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
    )
  }
  {
    role.environment && (
      <p class="env">
        <span class="stack-label">Stack:</span> {role.environment.join(', ')}
      </p>
    )
  }
  {role.caseStudySlug && <CaseStudyLink slug={role.caseStudySlug} />}
</article>
