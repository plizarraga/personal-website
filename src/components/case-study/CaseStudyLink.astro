---
import { getCaseStudy } from '@/lib/case-study/collection';
import { caseStudyPath } from '@/lib/case-study/paths';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const study = await getCaseStudy(slug);
---

<p><a href={caseStudyPath(slug)}>Read the {study.data.title} case study</a></p>
