---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DateRange from '@/components/DateRange.astro';
import { caseStudies } from '@/data/case-studies';
import { profile } from '@/data/cv';
import { caseStudyMarkdownPath, caseStudyPath } from '@/lib/case-study/paths';
import { caseStudySchema } from '@/lib/case-study/structured-data';

export const getStaticPaths = (() =>
  caseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } }))) satisfies GetStaticPaths;

const { study } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const path = caseStudyPath(study.slug);
/** The name is dropped from long titles so search results do not truncate them (about 60 characters). */
const fullTitle = `${study.title}: case study · ${profile.name}`;
const title = fullTitle.length <= 60 ? fullTitle : `${study.title}: case study`;
---

<BaseLayout
  {title}
  description={study.summary}
  {path}
  jsonLd={caseStudySchema(study)}
  markdownPath={caseStudyMarkdownPath(study.slug)}
>
  <article>
    <h1>{study.title}</h1>
    <p class="meta">
      <a href="/">{profile.name}</a> · {study.role}, {study.organization} · <span class="nowrap"><DateRange start={study.start} end={study.end} /></span>
      {study.status && ` (${study.status})`}
      {study.note && ` · ${study.note}`}
    </p>
    <p class="lede">{study.summary}</p>

    {
      study.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {section.steps && (
            <ol>
              {section.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
          )}
          {section.bullets && (
            <ul>
              {section.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    <section>
      <h2>Stack</h2>
      <p class="env">{study.stack.join(', ')}</p>
    </section>

    {
      study.repository && (
        <p>
          Source code: <a href={study.repository.url}>{study.repository.label}</a>
        </p>
      )
    }

    {
      study.productSite && (
        <p>
          Product site: <a href={study.productSite.url}>{study.productSite.label}</a>
        </p>
      )
    }

    <p class="more-links">
      <a href="/experience">Full experience, skills, and projects</a> · <a href={caseStudyMarkdownPath(study.slug)}>Markdown</a>
    </p>
  </article>
</BaseLayout>
