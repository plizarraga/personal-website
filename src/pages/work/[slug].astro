---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DateRange from '@/components/DateRange.astro';
import { profile } from '@/data/cv';
import { getCaseStudies } from '@/lib/case-study/collection';
import { caseStudyMarkdownPath, caseStudyPath } from '@/lib/case-study/paths';
import { caseStudySchema } from '@/lib/case-study/structured-data';

export const getStaticPaths = (async () =>
  (await getCaseStudies()).map((study) => ({ params: { slug: study.id }, props: { study } }))) satisfies GetStaticPaths;

const { study } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const { data } = study;
const { Content } = await render(study);
const path = caseStudyPath(study.id);
/** The name is dropped from long titles so search results do not truncate them (about 60 characters). */
const fullTitle = `${data.title}: case study · ${profile.name}`;
const title = fullTitle.length <= 60 ? fullTitle : `${data.title}: case study`;
---

<BaseLayout
  {title}
  description={data.summary}
  {path}
  jsonLd={caseStudySchema(study)}
  markdownPath={caseStudyMarkdownPath(study.id)}
>
  <article>
    <h1>{data.title}</h1>
    <p class="meta">
      <a href="/">{profile.name}</a> · {data.role}, {data.organization} · <span class="nowrap"><DateRange start={data.start} end={data.end} /></span>
      {data.status && ` (${data.status})`}
      {data.note && ` · ${data.note}`}
    </p>
    <p class="lede">{data.summary}</p>

    <Content />

    <h2 id="stack">Stack</h2>
    <p class="env">{data.stack.join(', ')}</p>

    {
      data.repository && (
        <p>
          Source code: <a href={data.repository.url}>{data.repository.label}</a>
        </p>
      )
    }

    {
      data.productSite && (
        <p>
          Product site: <a href={data.productSite.url}>{data.productSite.label}</a>
        </p>
      )
    }

    <p class="more-links">
      <a href="/experience">Full experience, skills, and projects</a> · <a href={caseStudyMarkdownPath(study.id)}>Markdown</a>
    </p>
  </article>
</BaseLayout>
