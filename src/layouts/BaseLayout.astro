---
import '@/styles/global.css';
import SiteFooter from '@/layouts/SiteFooter.astro';
import SiteHeader from '@/layouts/SiteHeader.astro';
import { profile } from '@/data/cv';
import { OG_IMAGE, absoluteUrl } from '@/lib/site';
import { serializeJsonLd } from '@/lib/json-ld';

interface Props {
  title: string;
  description: string;
  /** Site-relative path of the page. Omit it on pages that must not be indexed, such as the 404. */
  path?: string;
  ogType?: 'website' | 'profile';
  jsonLd?: Record<string, unknown>;
  /** Site-relative path of the Markdown copy of this page, if it has one. */
  markdownPath?: string;
}

const { title, description, path, ogType = 'website', jsonLd, markdownPath } = Astro.props;
const canonical = path ? absoluteUrl(path) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <meta name="author" content={profile.name} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={absoluteUrl(OG_IMAGE.path)} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />
    {
      ogType === 'profile' && (
        <>
          <meta property="profile:first_name" content={profile.givenName} />
          <meta property="profile:last_name" content={profile.familyName} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader currentPath={path} />
    <main id="main" class="container">
      <slot />
    </main>
    <SiteFooter currentPath={path} />
  </body>
</html>
