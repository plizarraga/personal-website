{
  "name": "personal-website",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && node scripts/check-posts.mjs && astro build && node scripts/check-dist.mjs && node scripts/check-a11y.mjs",
    "screenshot": "astro build && node scripts/screenshot.mjs",
    "check:posts": "node scripts/check-posts.mjs",
    "check:cv-master": "node scripts/check-cv-master.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "preview": "astro build && wrangler dev",
    "deploy": "node scripts/check-deploy-branch.mjs && node scripts/check-cv-master.mjs && node scripts/check-posts.mjs && HIDE_SCHEDULED=true astro build && node scripts/check-dist.mjs && node scripts/check-a11y.mjs && wrangler deploy && node scripts/indexnow.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "og-image": "node scripts/og-image.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.7",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.159.0"
  }
}
